<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Introductory text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A LITTLE HELP, EVERY DAY"
            android:textColor="#63836A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="25dp" />

        <!-- App illustration -->
        <ImageView
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:src="@drawable/splash_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Elderly Reminder illustration" />

        <!-- App name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elderly Reminder"
            android:textColor="#2D5C44"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="28dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your daily companion 🌷"
            android:textColor="#63836A"
            android:textSize="21sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Helping you remember the little things that matter."
            android:textColor="#8A8277"
            android:textSize="17sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginTop="14dp" />

        <!-- Bottom decoration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Made with care 💚"
            android:textColor="#2D5C44"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="45dp" />

    </LinearLayout>

</ScrollView>
