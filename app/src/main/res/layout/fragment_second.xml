<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a Reminder 🌷"
            android:textColor="#2D5C44"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="A little reminder for a happier day"
            android:textColor="#927D70"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="💗 What would you like to remember?"
            android:textColor="#2D5C44"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/reminder_title"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/reminder_input"
            android:hint="e.g. Take my medicine"
            android:inputType="textCapSentences"
            android:padding="16dp"
            android:textColor="#2D5C44"
            android:textColorHint="#A99B91"
            android:textSize="19sp"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/reminder_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Reminder date"
                android:textColor="#2D5C44"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/date_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/reminder_button"
                android:text="Choose Date"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/reminder_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏰ Reminder time"
                android:textColor="#2D5C44"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/time_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/reminder_button"
                android:text="Choose Time"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/save_reminder_button"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/reminder_button"
            android:text="💚 Save Reminder"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/button_second"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/reminder_back_button"
            android:text="← Back to Home"
            android:textColor="#2D5C44"
            android:textSize="19sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>