<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Reminders 🌷"
            android:textColor="#2D5C44"
            android:textSize="32sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/empty_reminders_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:text="No reminders yet. Add your first reminder!"
            android:textColor="#303931"
            android:textSize="23sp" />

        <LinearLayout
            android:id="@+id/reminders_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/button_first"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:text="+ Add Reminder"
            android:textSize="23sp"
            android:textAllCaps="false"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/assistant_button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="🎤 Talk to Assistant"
            android:textSize="23sp"
            android:textAllCaps="false"
            android:backgroundTint="#1565C0" />

        <Button
            android:id="@+id/language_button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="🌍 Language: English"
            android:textSize="23sp"
            android:textAllCaps="false"
            android:backgroundTint="#616161" />

    </LinearLayout>
</ScrollView>
