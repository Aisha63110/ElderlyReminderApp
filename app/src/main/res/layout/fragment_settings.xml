<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Settings"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#2D5C44"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtSettingsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalise your reminder experience."
            android:textSize="17sp"
            android:textColor="#8A8277"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:id="@+id/txtLanguageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌍 Language"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D5C44"/>

        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:text="Change Language"
            android:textSize="17sp"
            android:layout_marginBottom="22dp"/>

        <TextView
            android:id="@+id/txtTextSizeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔠 Text Size"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D5C44"/>

        <Button
            android:id="@+id/btnTextSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:text="Adjust Text Size"
            android:textSize="17sp"
            android:layout_marginBottom="22dp"/>

        <TextView
            android:id="@+id/txtPrivacyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 Privacy"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D5C44"/>

        <Button
            android:id="@+id/btnPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:text="Privacy Information"
            android:textSize="17sp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>
