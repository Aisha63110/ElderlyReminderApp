<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SpinnerPickerDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:datePickerStyle">@style/SpinnerDatePicker</item>
        <item name="android:timePickerStyle">@style/SpinnerTimePicker</item>
        <item name="android:colorAccent">#2E7D32</item>
    </style>

    <style name="SpinnerDatePicker" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
        <item name="android:spinnersShown">true</item>
    </style>

    <style name="SpinnerTimePicker" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">spinner</item>
        <item name="android:spinnersShown">true</item>
    </style>

</resources>
